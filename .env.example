# Run scripts/bootstrap.sh to create .env: it generates random secrets for
# every __GENERATED__ value and sets file permissions to 600.
# .env is gitignored

# --- Generated by bootstrap (random per machine) ------------------------------
POSTGRES_USER=radar
POSTGRES_PASSWORD=__GENERATED__
POSTGRES_DB=radar
POSTGRES_DSN=postgresql+asyncpg://radar:__GENERATED__@localhost:5432/radar
VAULT_DEV_ROOT_TOKEN=__GENERATED__
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATED__

# --- Non-secret endpoints ------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
VAULT_ADDR=http://localhost:8200

# --- Fill in manually (external credentials, never generated) ------------------
OPENAI_API_KEY=__SET_ME__
SLACK_BOT_TOKEN=__SET_ME__
SLACK_APP_TOKEN=__SET_ME__
