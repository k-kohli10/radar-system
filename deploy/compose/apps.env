# Non-secret config for the radar-apps stack. No secrets here — every credential
# is materialised into /vault/secrets by the per-service vault-init sidecar.
# Endpoints resolve by container name; every app image listens on 8080.

RADAR_SECRETS_DIR=/vault/secrets
RADAR_LOG_LEVEL=INFO

RADAR_GATEWAY_URL=http://llm-gateway:8080
RADAR_KNOWLEDGE_URL=http://knowledge-service:8080
RADAR_ELASTICSEARCH_URL=http://elasticsearch:9200
RADAR_DISPATCH_URL_OVERRIDES={"watcher-agent":"http://watcher-agent:8080/events","planner-agent":"http://planner-agent:8080/events","reasoner-agent":"http://reasoner-agent:8080/events","feedback-service":"http://feedback-service:8080/events"}

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
