{
  "uid": "incident-pipeline",
  "title": "RADAR \u2014 Incident Pipeline",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "radar"
  ],
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Incidents opened (/s)",
      "description": "Reads 'No data' until radar_incidents_total is instrumented: the counter is defined but never incremented (ingestion should count each incident it opens). Wired in the same pre-step-12 instrumentation commit as the latency metric.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "radar-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "radar-prometheus"
          },
          "expr": "sum by (service, severity) (rate(radar_incidents_total[5m]))",
          "legendFormat": "{{service}} {{severity}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Plans created (/s)",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "radar-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "radar-prometheus"
          },
          "expr": "sum by (outcome) (rate(radar_plans_created_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Recommendations (/s)",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "radar-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "radar-prometheus"
          },
          "expr": "sum by (confidence) (rate(radar_recommendations_total[5m]))",
          "legendFormat": "{{confidence}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Template fallbacks (/s)",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "radar-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "radar-prometheus"
          },
          "expr": "sum by (reason) (rate(radar_recommendations_fallback_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ingestion->recommendation latency p50/p95 (s) [pending instrumentation]",
      "description": "Reads 'No data' until radar_incident_duration_seconds is instrumented. That histogram is defined but never observed yet; a dedicated pre-step-12 commit wires the .observe() to measure INGESTION-TO-RECOMMENDATION latency (recommendation.created_at - incident.created_at), i.e. pipeline latency, NOT open-to-resolution (which would include human-loop time). Step 12 reads p50/p95 off this panel once populated.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "radar-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "radar-prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(radar_incident_duration_seconds_bucket[10m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "radar-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(radar_incident_duration_seconds_bucket[10m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    }
  ]
}
